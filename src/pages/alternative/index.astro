---
import Base from '../../layouts/Base.astro';

import type { AltPage } from '../../data/alternatives/types';

// Live pages come from src/data/alternatives/*.ts automatically (one file = one page).
const mods = import.meta.glob<{ default: AltPage }>('../../data/alternatives/*.ts', { eager: true });
const live = Object.entries(mods)
  .filter(([path]) => !path.endsWith('/types.ts'))
  .map(([path, m]) => ({ slug: path.split('/').pop()!.replace(/\.ts$/, ''), name: m.default.competitor, desc: m.default.sub }));
const ORDER = ['speechify', 'naturalreader', 'elevenreader', 'read-aloud', 'ttsreader'];
live.sort((x, y) => (ORDER.indexOf(x.slug) + 1 || 99) - (ORDER.indexOf(y.slug) + 1 || 99));

// Planned pages: shown as "Coming soon" (not clickable) until a data file exists.
const COMING = [
  { name: 'Balabolka', desc: 'A free reader that works in your browser on any computer, not just Windows.' },
  { name: 'Read&Write', desc: 'Natural voices for reading the web, without a school licence.' },
  { name: 'Snap&Read', desc: 'A simple, free reader for students on any website.' },
  { name: 'Voice Dream Reader', desc: 'Natural voices on the desktop web, free.' },
];
const STORE = 'https://chrome.google.com/webstore/detail/ckkihjnakpnccnmdipbdibeaibigjjde';
---

<Base
  title="Text to Speech Alternatives Compared — Voq"
  description="How Voq compares with Speechify, NaturalReader, ElevenReader, Read Aloud and other text to speech readers. Honest side-by-side comparisons of price, voices and limits."
  path="/alternative"
  localized={false}
>
  <div class="container alt-index">
    <div class="page-header">
      <h1>Voq vs other text to speech tools</h1>
      <p>Honest side-by-side comparisons — what each tool does well, what it costs, and where Voq fits.</p>
    </div>

    <ul class="tools">
      {live.map((t) => (
        <li><a class="tool" href={`/alternative/${t.slug}`}>
          <span class="name">{t.name} alternative <span aria-hidden="true">→</span></span>
          <span class="desc">{t.desc}</span>
        </a></li>
      ))}
      {COMING.map((t) => (
        <li><div class="tool soon">
          <span class="name">{t.name} alternative <span class="badge">Coming soon</span></span>
          <span class="desc">{t.desc}</span>
        </div></li>
      ))}
    </ul>

    <div class="cta-block">
      <p>Natural voices on any webpage. Free, no account, 34 languages.</p>
      <a class="btn" href={STORE} target="_blank" rel="noopener">Add to Chrome — It's Free</a>
    </div>
  </div>
</Base>

<style>
  .alt-index { padding-top: 1rem; padding-bottom: 3rem; }
  .tools { list-style: none; display: flex; flex-direction: column; gap: 0.75rem; margin: 2rem 0; }
  .tool { display: flex; flex-direction: column; gap: 0.3rem; padding: 1.1rem 1.25rem; border: 1px solid var(--color-border); border-radius: 8px; background: var(--color-surface); color: var(--color-text); }
  a.tool:hover { border-color: var(--color-accent); text-decoration: none; }
  .name { display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; font-weight: 600; font-size: 1.05rem; }
  .desc { color: var(--color-muted); font-size: 0.95rem; }
  .tool.soon { background: #fff; border-style: dashed; }
  .tool.soon .name { color: #4b5563; }
  .badge { flex: none; font-size: 0.68rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: #4b5563; background: #f3f4f6; padding: 0.2rem 0.5rem; border-radius: 999px; }
</style>
