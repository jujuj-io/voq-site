---
import { existsSync } from 'node:fs';
import path from 'node:path';
import demo from '../data/demo.json';

interface Props { ctaUrl: string; lang?: string }
const { ctaUrl, lang = 'en' } = Astro.props;

type Voice = { english: string; native: string; rtl: boolean; text: string };
const allVoices = demo.voices as Record<string, Voice>;
const ui = (demo.ui as Record<string, Record<string, string>>)[lang] ?? demo.ui.en;

// Only offer languages whose audio has been exported (node scripts/build-demo-audio.mjs).
const audioDir = path.join(process.cwd(), 'public/demo');
const voices = Object.fromEntries(
  Object.entries(allVoices).filter(([code]) => existsSync(path.join(audioDir, `${code}.mp3`)))
);
const codes = Object.keys(voices);
const preferred = (demo.siteLocaleVoice as Record<string, string>)[lang] ?? 'en';
const initial = voices[preferred] ? preferred : voices.en ? 'en' : codes[0];
const label = (v: Voice) => (v.native === v.english ? v.native : `${v.native} · ${v.english}`);
const sorted = [...codes].sort((a, b) => allVoices[a].english.localeCompare(allVoices[b].english));
const clientVoices = Object.fromEntries(codes.map((c) => [c, { text: voices[c].text, rtl: voices[c].rtl }]));
---

{initial && (
<div class="vd" data-state="idle" data-initial={initial} data-voices={JSON.stringify(clientVoices)} data-ui={JSON.stringify(ui)}>
  <div class="vd-win">
    <div class="vd-bar">
      <div class="vd-dots" aria-hidden="true"><i></i><i></i><i></i></div>
      <label class="vd-lang">
        <span class="vd-sr">Language</span>
        <svg viewBox="0 0 20 20" width="15" height="15" aria-hidden="true"><circle cx="10" cy="10" r="7.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M2.5 10h15M10 2.5c2.2 2.2 3.2 4.7 3.2 7.5s-1 5.3-3.2 7.5c-2.2-2.2-3.2-4.7-3.2-7.5s1-5.3 3.2-7.5z" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
        <select class="vd-select">
          {sorted.map((c) => <option value={c} selected={c === initial}>{label(voices[c])}</option>)}
        </select>
        <svg class="vd-chev" viewBox="0 0 12 12" width="10" height="10" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </label>
    </div>

    <div class="vd-page">
      <div class="vd-paper">
        <div class="vd-reader" lang={initial} dir={voices[initial].rtl ? 'rtl' : 'ltr'}>{voices[initial].text}</div>
      </div>

      <div class="vd-player">
        <div class="vd-progress"><span></span></div>
        <div class="vd-info">
          <span class="vd-cur">0:00</span>
          <span class="vd-now">{ui.press}</span>
          <span class="vd-dur">0:00</span>
        </div>
        <div class="vd-controls">
          <span class="vd-avatar" aria-hidden="true">v</span>
          <button type="button" class="vd-skip" data-skip="-5" aria-label="Back 5 seconds">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 7.2v9.6a.8.8 0 0 1-1.25.66L3.6 12.66a.8.8 0 0 1 0-1.32l6.15-4.8A.8.8 0 0 1 11 7.2zm9 0v9.6a.8.8 0 0 1-1.25.66l-6.15-4.8a.8.8 0 0 1 0-1.32l6.15-4.8A.8.8 0 0 1 20 7.2z"/></svg>
          </button>
          <button type="button" class="vd-play" aria-label="Play">
            <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z"/></svg>
            <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><rect x="6.5" y="5" width="4" height="14" rx="1.5"/><rect x="13.5" y="5" width="4" height="14" rx="1.5"/></svg>
            <span class="i-spin" aria-hidden="true"></span>
          </button>
          <button type="button" class="vd-skip" data-skip="5" aria-label="Forward 5 seconds">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 7.2v9.6a.8.8 0 0 0 1.25.66l6.15-4.8a.8.8 0 0 0 0-1.32l-6.15-4.8A.8.8 0 0 0 13 7.2zm-9 0v9.6a.8.8 0 0 0 1.25.66l6.15-4.8a.8.8 0 0 0 0-1.32L5.25 6.54A.8.8 0 0 0 4 7.2z"/></svg>
          </button>
          <button type="button" class="vd-speed" aria-label="Playback speed">1x</button>
        </div>
      </div>
    </div>
  </div>

  <p class="vd-tip">{ui.tap}</p>
  <p class="vd-status" role="status"></p>
  <div class="vd-cta" hidden>
    <span>{ui.cta}</span>
    <a href={ctaUrl} target="_blank" rel="noopener">{ui.ctaLink}</a>
  </div>
</div>
)}

<script>
  type ClientVoice = { text: string; rtl: boolean };

  document.querySelectorAll<HTMLElement>('.vd').forEach((root) => {
    const voices: Record<string, ClientVoice> = JSON.parse(root.dataset.voices!);
    const ui: Record<string, string> = JSON.parse(root.dataset.ui!);
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const reader = $('.vd-reader');
    const select = $<HTMLSelectElement>('.vd-select');
    const playBtn = $<HTMLButtonElement>('.vd-play');
    const speedBtn = $<HTMLButtonElement>('.vd-speed');
    const curEl = $('.vd-cur');
    const durEl = $('.vd-dur');
    const nowEl = $('.vd-now');
    const fill = $('.vd-progress span');
    const status = $('.vd-status');
    const cta = $('.vd-cta');

    const SPEEDS = [1, 1.25, 1.5, 2];
    const SENT_END = /[.!?。！？।؟]/;
    const CJK = /[぀-ヿ㐀-鿿가-힯]/;
    let speedIdx = 0;
    let code = root.dataset.initial!;
    let state: 'idle' | 'loading' | 'playing' | 'paused' = 'idle';
    let words: { el: HTMLElement; s: number }[] = [];
    let sentences: { el: HTMLElement; text: string }[] = [];
    let marks: number[] = [];
    let total = 1;
    let curWord = -1;
    let curSent = -1;
    let raf = 0;
    let pendingSeek: number | null = null;

    // Static, pre-generated audio: one file per language, no API calls.
    const audio = new Audio();
    audio.preload = 'metadata';

    const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
    const short = (s: string) => ([...s].length > 34 ? [...s].slice(0, 32).join('').trimEnd() + '…' : s);

    function setState(next: typeof state) {
      state = next;
      root.dataset.state = next;
      playBtn.disabled = next === 'loading';
      playBtn.setAttribute('aria-label', next === 'playing' ? 'Pause' : 'Play');
    }

    function segments(text: string, locale: string): { seg: string; word: boolean }[] {
      const Seg = (Intl as any).Segmenter;
      if (Seg) {
        return [...new Seg(locale, { granularity: 'word' }).segment(text)].map((x: any) => ({ seg: x.segment, word: !!x.isWordLike }));
      }
      return text.split(/(\s+)/).filter(Boolean).map((t) => ({ seg: t, word: !/^\s+$/.test(t) }));
    }

    // Build the clickable karaoke text. Timing is estimated from word length and punctuation pauses.
    function buildReader() {
      const v = voices[code];
      reader.textContent = '';
      reader.lang = code;
      reader.dir = v.rtl ? 'rtl' : 'ltr';
      words = []; sentences = []; marks = []; total = 0;
      let sentEl: HTMLElement | null = null;
      for (const { seg, word } of segments(v.text, code)) {
        const isSpace = /^\s+$/.test(seg);
        if (!sentEl && !isSpace) {
          sentEl = document.createElement('span');
          sentEl.className = 'sent';
          reader.append(sentEl);
          sentences.push({ el: sentEl, text: '' });
        }
        if (isSpace) {
          (sentEl ?? reader).append(seg);
          if (sentEl) sentences[sentences.length - 1].text += seg;
          continue;
        }
        if (!sentEl) { reader.append(seg); continue; }
        sentences[sentences.length - 1].text += seg;
        if (word) {
          const el = document.createElement('span');
          el.className = 'word';
          el.textContent = seg;
          el.dataset.i = String(words.length);
          sentEl.append(el);
          words.push({ el, s: sentences.length - 1 });
          marks.push(total);
          total += [...seg].length * (CJK.test(seg) ? 2.2 : 1) + 1;
        } else {
          sentEl.append(seg);
          if (SENT_END.test(seg)) total += 8;
          else if (/[:;：；]/.test(seg)) total += 6;
          else if (/[,،、，—–]/.test(seg)) total += 3;
          if (SENT_END.test(seg)) sentEl = null;
        }
      }
      sentences.forEach((x) => (x.text = x.text.trim()));
      curWord = -1; curSent = -1;
      reader.scrollTop = 0;
    }

    function highlight(i: number) {
      if (i === curWord || !words[i]) return;
      words[curWord]?.el.classList.remove('w-on');
      words[i].el.classList.add('w-on');
      curWord = i;
      const s = words[i].s;
      if (s !== curSent) {
        sentences[curSent]?.el.classList.remove('s-on');
        sentences[s].el.classList.add('s-on');
        curSent = s;
        nowEl.textContent = short(sentences[s].text);
      }
      const el = words[i].el;
      const target = el.offsetTop - reader.clientHeight * 0.4;
      if (Math.abs(reader.scrollTop - target) > 24) reader.scrollTo({ top: Math.max(0, target), behavior: 'smooth' });
    }

    function sync() {
      if (!audio.duration) return;
      const w = Math.min(1, (audio.currentTime + 0.12) / audio.duration) * total;
      let i = 0;
      while (i + 1 < marks.length && marks[i + 1] <= w) i++;
      highlight(i);
      curEl.textContent = fmt(audio.currentTime);
      fill.style.width = `${(audio.currentTime / audio.duration) * 100}%`;
    }

    function loop() {
      sync();
      if (state === 'playing') raf = requestAnimationFrame(loop);
    }

    function clearMarks() {
      words[curWord]?.el.classList.remove('w-on');
      sentences[curSent]?.el.classList.remove('s-on');
      curWord = -1; curSent = -1;
    }

    function loadVoice(next: string) {
      cancelAnimationFrame(raf);
      audio.pause();
      code = next;
      audio.src = `/demo/${code}.mp3`;
      audio.playbackRate = SPEEDS[speedIdx];
      buildReader();
      fill.style.width = '0%';
      curEl.textContent = '0:00';
      durEl.textContent = '0:00';
      nowEl.textContent = ui.press;
      status.textContent = '';
      setState('idle');
    }

    async function start() {
      status.textContent = '';
      if (audio.readyState < 1) { setState('loading'); nowEl.textContent = ui.loading; }
      try {
        await audio.play();
        audio.playbackRate = SPEEDS[speedIdx];
        setState('playing');
        raf = requestAnimationFrame(loop);
      } catch {
        setState('idle');
        nowEl.textContent = ui.press;
        status.textContent = ui.error;
      }
    }

    function timeForWord(i: number) {
      return Math.max(0, (marks[i] / total) * audio.duration - 0.08);
    }

    function seekToWord(i: number) {
      if (audio.duration) {
        audio.currentTime = timeForWord(i);
        sync();
      } else {
        pendingSeek = i;
      }
      if (state !== 'playing') start();
    }

    playBtn.addEventListener('click', () => {
      if (state === 'playing') {
        audio.pause();
        cancelAnimationFrame(raf);
        setState('paused');
      } else {
        start();
      }
    });

    reader.addEventListener('click', (e) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>('.word');
      if (el) seekToWord(Number(el.dataset.i));
    });

    root.querySelectorAll<HTMLButtonElement>('.vd-skip').forEach((b) =>
      b.addEventListener('click', () => {
        if (!audio.duration) return;
        audio.currentTime = Math.max(0, Math.min(audio.duration - 0.05, audio.currentTime + Number(b.dataset.skip)));
        sync();
      })
    );

    speedBtn.addEventListener('click', () => {
      speedIdx = (speedIdx + 1) % SPEEDS.length;
      audio.playbackRate = SPEEDS[speedIdx];
      speedBtn.textContent = `${SPEEDS[speedIdx]}x`;
    });

    select.addEventListener('change', () => loadVoice(select.value));

    audio.addEventListener('loadedmetadata', () => {
      durEl.textContent = fmt(audio.duration);
      if (pendingSeek !== null) { audio.currentTime = timeForWord(pendingSeek); pendingSeek = null; }
    });
    audio.addEventListener('ended', () => {
      cancelAnimationFrame(raf);
      clearMarks();
      fill.style.width = '100%';
      curEl.textContent = fmt(audio.duration);
      nowEl.textContent = ui.again;
      setState('idle');
      cta.hidden = false;
    });
    audio.addEventListener('error', () => {
      if (!audio.src) return;
      setState('idle');
      status.textContent = ui.error;
    });

    loadVoice(code);
  });
</script>

<style>
  .vd {
    --blue: var(--color-accent);
    --ink: #1c1f24;
    --soft: #8b919a;
    width: 100%;
    max-width: 540px;
    margin: 0 auto;
    text-align: start;
  }
  .vd-win {
    background: #fff;
    border-radius: 18px;
    border: 1px solid rgba(15, 23, 42, 0.08);
    box-shadow: 0 2px 4px rgba(15, 23, 42, 0.04), 0 24px 60px -18px rgba(15, 23, 42, 0.28);
    overflow: hidden;
  }

  .vd-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    height: 50px;
    padding: 0 0.7rem 0 0.9rem;
    border-bottom: 1px solid #eef0f3;
  }
  .vd-dots { display: flex; gap: 6px; flex: none; }
  .vd-dots i { width: 10px; height: 10px; border-radius: 50%; background: #e3e6ea; }

  .vd-lang {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-width: 0;
    max-width: 72%;
    padding: 0 0.7rem;
    height: 34px;
    border-radius: 999px;
    background: #f4f5f7;
    color: var(--ink);
    cursor: pointer;
    transition: background 0.15s;
  }
  .vd-lang:hover { background: #eceef2; }
  .vd-lang:focus-within { box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.25); }
  .vd-lang svg { flex: none; color: var(--soft); }
  .vd-select {
    appearance: none;
    -webkit-appearance: none;
    min-width: 0;
    border: 0;
    background: transparent;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink);
    padding-inline-end: 0.9rem;
    margin-inline-end: -0.9rem;
    cursor: pointer;
    text-overflow: ellipsis;
    outline: none;
  }
  .vd-chev { pointer-events: none; }

  .vd-page { background: #f3f4f6; padding: 1.1rem 1.1rem 0; display: flow-root; }
  .vd-paper {
    position: relative;
    background: #fff;
    border-radius: 10px;
    box-shadow: 0 0 0 1px rgba(15, 23, 42, 0.04), 0 1px 3px rgba(15, 23, 42, 0.04);
    overflow: hidden;
  }
  .vd-paper::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 3.5rem;
    background: linear-gradient(rgba(255, 255, 255, 0), #fff 75%);
    pointer-events: none;
  }
  .vd-reader {
    height: 15.5rem;
    padding: 1.5rem 1.75rem 3.25rem;
    font-family: Charter, 'Iowan Old Style', Georgia, 'Times New Roman', serif;
    font-size: 1.12rem;
    line-height: 1.85;
    color: var(--ink);
    overflow-y: auto;
    scrollbar-width: none;
    user-select: none;
  }
  .vd-reader:lang(ja), .vd-reader:lang(zh-CN), .vd-reader:lang(ko),
  .vd-reader:lang(ar), .vd-reader:lang(he), .vd-reader:lang(hi), .vd-reader:lang(bn),
  .vd-reader:lang(gu), .vd-reader:lang(kn), .vd-reader:lang(ml), .vd-reader:lang(mr), .vd-reader:lang(ta) {
    font-family: var(--font-sans);
    font-size: 1.05rem;
  }
  .vd-reader::-webkit-scrollbar { display: none; }
  .vd-reader :global(.sent), .vd-reader :global(.word) {
    border-radius: 5px;
    padding: 0.12em 0;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    transition: background-color 0.18s, box-shadow 0.18s;
  }
  .vd-reader :global(.word) { cursor: pointer; }
  .vd-reader :global(.word:hover) { background: #f1f4fb; box-shadow: 0 0 0 2px #f1f4fb; }
  .vd-reader :global(.sent.s-on) { background: #eaf0ff; box-shadow: 0 0 0 3px #eaf0ff; }
  .vd-reader :global(.word.w-on) { background: #c7d5ff; box-shadow: 0 0 0 3px #c7d5ff; }

  .vd-player {
    position: relative;
    margin: -2.4rem auto 1.1rem;
    width: min(360px, calc(100% - 1.5rem));
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 0 0 1px rgba(15, 23, 42, 0.06), 0 16px 36px -12px rgba(15, 23, 42, 0.3);
    overflow: hidden;
    z-index: 2;
  }
  .vd-progress { height: 3px; background: #eceef2; }
  .vd-progress span { display: block; height: 100%; width: 0; background: var(--blue); }
  .vd-info {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.55rem 0.95rem 0;
    font-size: 0.72rem;
    color: #a0a6ae;
    font-variant-numeric: tabular-nums;
  }
  .vd-now {
    flex: 1;
    min-width: 0;
    text-align: center;
    color: var(--soft);
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .vd-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.35rem 0.8rem 0.75rem;
    direction: ltr;
  }
  .vd-avatar {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #111;
    color: #fff;
    font-weight: 800;
    font-size: 1.05rem;
    padding-bottom: 2px;
  }
  .vd-skip, .vd-speed {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition: background 0.15s;
  }
  .vd-skip svg { width: 20px; height: 20px; fill: currentColor; }
  .vd-skip:hover, .vd-speed:hover { background: #f2f4f7; }
  .vd-speed {
    width: auto;
    min-width: 44px;
    height: 34px;
    padding: 0 0.55rem;
    border-radius: 999px;
    background: #f4f5f7;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 700;
  }
  .vd-play {
    position: relative;
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border: 0;
    border-radius: 50%;
    background: var(--blue);
    color: #fff;
    cursor: pointer;
    box-shadow: 0 10px 22px -8px rgba(37, 99, 235, 0.75);
    transition: transform 0.15s, background 0.15s;
  }
  .vd-play:hover { background: var(--color-accent-hover); transform: scale(1.04); }
  .vd-play:active { transform: scale(0.96); }
  .vd-play:focus-visible { outline: 3px solid rgba(37, 99, 235, 0.35); outline-offset: 3px; }
  .vd-play svg { grid-area: 1 / 1; width: 24px; height: 24px; fill: currentColor; }
  .vd-play .i-play { margin-left: 3px; }
  .vd-play .i-pause, .vd-play .i-spin { display: none; }
  .vd[data-state='playing'] .i-play { display: none; }
  .vd[data-state='playing'] .i-pause { display: block; }
  .vd[data-state='loading'] .vd-play { cursor: progress; }
  .vd[data-state='loading'] .i-play { display: none; }
  .vd[data-state='loading'] .i-spin {
    display: block;
    grid-area: 1 / 1;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 2.5px solid rgba(255, 255, 255, 0.35);
    border-top-color: #fff;
    animation: vd-spin 0.7s linear infinite;
  }
  .vd[data-state='idle'] .vd-play::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    animation: vd-ping 2.2s ease-out infinite;
  }

  .vd-tip { margin: 0.8rem 0 0; font-size: 0.8rem; color: #9aa0a8; text-align: center; }
  .vd-status { margin: 0.5rem 0 0; font-size: 0.88rem; color: #b45309; text-align: center; }
  .vd-status:empty { display: none; }
  .vd-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.8rem;
    padding: 0.8rem 1.1rem;
    border-radius: 12px;
    background: #edf2ff;
    color: #1e3a8a;
    font-size: 0.9rem;
    animation: vd-in 0.35s ease-out;
  }
  .vd-cta[hidden] { display: none; }
  .vd-cta a { font-weight: 700; white-space: nowrap; }

  .vd-sr {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }

  @keyframes vd-spin { to { transform: rotate(360deg); } }
  @keyframes vd-ping {
    0% { box-shadow: 0 0 0 0 rgba(37, 99, 235, 0.5); }
    70%, 100% { box-shadow: 0 0 0 14px rgba(37, 99, 235, 0); }
  }
  @keyframes vd-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .vd *, .vd *::after { animation: none !important; transition: none !important; }
  }
  @media (max-width: 520px) {
    .vd-page { padding: 0.7rem 0.7rem 0; }
    .vd-reader { height: 14rem; padding: 1.2rem 1.2rem 3rem; font-size: 1.04rem; }
    .vd-cta { flex-direction: column; align-items: flex-start; }
  }
</style>
