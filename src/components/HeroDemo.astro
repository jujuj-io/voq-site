---
import { existsSync } from 'node:fs';
import path from 'node:path';
import demo from '../data/demo.json';

interface Props { ctaUrl: string; lang?: string }
const { ctaUrl, lang = 'en' } = Astro.props;

type Voice = { english: string; native: string; rtl: boolean; text: string };
const allVoices = demo.voices as Record<string, Voice>;
const ui = (demo.ui as Record<string, Record<string, string>>)[lang] ?? demo.ui.en;

// Only offer languages whose audio has been exported (node scripts/build-demo-audio.mjs).
const audioDir = path.join(process.cwd(), 'public/demo');
const voices = Object.fromEntries(
  Object.entries(allVoices).filter(([code]) => existsSync(path.join(audioDir, `${code}.mp3`)))
);
const codes = Object.keys(voices);
const preferred = (demo.siteLocaleVoice as Record<string, string>)[lang] ?? 'en';
const initial = voices[preferred] ? preferred : voices.en ? 'en' : codes[0];
const sorted = [...codes].sort((a, b) => allVoices[a].english.localeCompare(allVoices[b].english));
const clientVoices = Object.fromEntries(codes.map((c) => [c, { text: voices[c].text, rtl: voices[c].rtl }]));
---

{initial && (
<div class="vd" data-state="idle" data-initial={initial} data-voices={JSON.stringify(clientVoices)} data-ui={JSON.stringify(ui)}>
  <div class="vd-win">
    <div class="vd-bar">
      <div class="vd-dots" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="vd-lang">
        <button type="button" class="vd-lang-btn" aria-haspopup="listbox" aria-expanded="false">
          <svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true"><circle cx="10" cy="10" r="7.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M2.5 10h15M10 2.5c2.2 2.2 3.2 4.7 3.2 7.5s-1 5.3-3.2 7.5c-2.2-2.2-3.2-4.7-3.2-7.5s1-5.3 3.2-7.5z" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
          <span class="vd-lang-cur">{voices[initial].native}</span>
          <svg class="vd-chev" viewBox="0 0 12 12" width="9" height="9" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="vd-pop" hidden>
          <input class="vd-search" type="text" placeholder={`${ui.search} (${codes.length})`} aria-label={ui.search} autocomplete="off" spellcheck="false" />
          <ul class="vd-list" role="listbox" aria-label={ui.search}>
            {sorted.map((c) => (
              <li role="option" data-code={c} data-q={`${voices[c].native} ${voices[c].english} ${c}`.toLowerCase()} aria-selected={c === initial ? 'true' : 'false'}>
                <span class="n">{voices[c].native}</span>
                {voices[c].native !== voices[c].english && <span class="e">{voices[c].english}</span>}
              </li>
            ))}
          </ul>
          <p class="vd-nomatch" hidden>{ui.noMatch}</p>
        </div>
      </div>
      <div class="vd-size" role="group" aria-label="Text size">
        <button type="button" data-size="-1" aria-label="Smaller text">A<span>−</span></button>
        <button type="button" data-size="1" aria-label="Larger text" class="big">A<span>+</span></button>
      </div>
    </div>

    <div class="vd-page">
      <div class="vd-paper">
        <div class="vd-reader" data-size="1" lang={initial} dir={voices[initial].rtl ? 'rtl' : 'ltr'}><p>{voices[initial].text}</p></div>
      </div>

      <div class="vd-player">
        <div class="vd-progress"><span></span></div>
        <div class="vd-info">
          <span class="vd-cur">0:00</span>
          <span class="vd-now">{ui.press}</span>
          <span class="vd-dur">0:00</span>
        </div>
        <div class="vd-controls">
          <span class="vd-avatar" aria-hidden="true">v</span>
          <button type="button" class="vd-skip" data-skip="-5" aria-label="Back 5 seconds">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 7.2v9.6a.8.8 0 0 1-1.25.66L3.6 12.66a.8.8 0 0 1 0-1.32l6.15-4.8A.8.8 0 0 1 11 7.2zm9 0v9.6a.8.8 0 0 1-1.25.66l-6.15-4.8a.8.8 0 0 1 0-1.32l6.15-4.8A.8.8 0 0 1 20 7.2z"/></svg>
          </button>
          <button type="button" class="vd-play" aria-label="Play">
            <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z"/></svg>
            <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><rect x="6.5" y="5" width="4" height="14" rx="1.5"/><rect x="13.5" y="5" width="4" height="14" rx="1.5"/></svg>
            <span class="i-spin" aria-hidden="true"></span>
          </button>
          <button type="button" class="vd-skip" data-skip="5" aria-label="Forward 5 seconds">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 7.2v9.6a.8.8 0 0 0 1.25.66l6.15-4.8a.8.8 0 0 0 0-1.32l-6.15-4.8A.8.8 0 0 0 13 7.2zm-9 0v9.6a.8.8 0 0 0 1.25.66l6.15-4.8a.8.8 0 0 0 0-1.32L5.25 6.54A.8.8 0 0 0 4 7.2z"/></svg>
          </button>
          <button type="button" class="vd-speed" aria-label="Playback speed">1x</button>
        </div>
        <p class="vd-tip">{ui.tap}</p>
      </div>
    </div>
  </div>

  <p class="vd-status" role="status"></p>
  <div class="vd-cta" hidden>
    <span>{ui.cta}</span>
    <a href={ctaUrl} target="_blank" rel="noopener">{ui.ctaLink}</a>
  </div>
</div>
)}

<script>
  type ClientVoice = { text: string; rtl: boolean };

  document.querySelectorAll<HTMLElement>('.vd').forEach((root) => {
    const voices: Record<string, ClientVoice> = JSON.parse(root.dataset.voices!);
    const ui: Record<string, string> = JSON.parse(root.dataset.ui!);
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const reader = $('.vd-reader');
    const langBtn = $<HTMLButtonElement>('.vd-lang-btn');
    const langCur = $('.vd-lang-cur');
    const pop = $('.vd-pop');
    const search = $<HTMLInputElement>('.vd-search');
    const noMatch = $('.vd-nomatch');
    const items = [...root.querySelectorAll<HTMLLIElement>('.vd-list li')];
    const SIZES = 3;
    const playBtn = $<HTMLButtonElement>('.vd-play');
    const speedBtn = $<HTMLButtonElement>('.vd-speed');
    const curEl = $('.vd-cur');
    const durEl = $('.vd-dur');
    const nowEl = $('.vd-now');
    const fill = $('.vd-progress span');
    const status = $('.vd-status');
    const cta = $('.vd-cta');

    const SPEEDS = [1, 1.25, 1.5, 2];
    const SENT_END = /[.!?。！？।؟]/;
    const CJK = /[぀-ヿ㐀-鿿가-힯]/;
    let speedIdx = 0;
    let code = root.dataset.initial!;
    let state: 'idle' | 'loading' | 'playing' | 'paused' = 'idle';
    let words: { el: HTMLElement; s: number }[] = [];
    let sentences: { el: HTMLElement; text: string }[] = [];
    let marks: number[] = [];
    let total = 1;
    let curWord = -1;
    let curSent = -1;
    let raf = 0;
    let pendingSeek: number | null = null;

    // Static, pre-generated audio: one file per language, no API calls.
    const audio = new Audio();
    audio.preload = 'metadata';

    const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
    const short = (s: string) => ([...s].length > 34 ? [...s].slice(0, 32).join('').trimEnd() + '…' : s);

    function setState(next: typeof state) {
      state = next;
      root.dataset.state = next;
      playBtn.disabled = next === 'loading';
      playBtn.setAttribute('aria-label', next === 'playing' ? 'Pause' : 'Play');
    }

    function segments(text: string, locale: string): { seg: string; word: boolean }[] {
      const Seg = (Intl as any).Segmenter;
      if (Seg) {
        return [...new Seg(locale, { granularity: 'word' }).segment(text)].map((x: any) => ({ seg: x.segment, word: !!x.isWordLike }));
      }
      return text.split(/(\s+)/).filter(Boolean).map((t) => ({ seg: t, word: !/^\s+$/.test(t) }));
    }

    // Build the clickable karaoke text, split into short paragraphs.
    // Timing is estimated from word length and punctuation pauses.
    function buildReader() {
      const v = voices[code];
      reader.textContent = '';
      reader.lang = code;
      reader.dir = v.rtl ? 'rtl' : 'ltr';
      words = []; sentences = []; marks = []; total = 0;

      // Pass 1: group segments into sentences.
      const groups: { seg: string; word: boolean }[][] = [[]];
      for (const x of segments(v.text, code)) {
        const g = groups[groups.length - 1];
        if (/^\s+$/.test(x.seg) && !g.length) continue;
        g.push(x);
        if (!x.word && SENT_END.test(x.seg)) groups.push([]);
      }
      if (!groups[groups.length - 1].length) groups.pop();

      // Paragraphs: intro | what it does | when to use it | call to action.
      const n = groups.length;
      const breaks = new Set(n >= 5 ? [2, 4, n - 1] : n >= 3 ? [2] : []);
      let para = document.createElement('p');
      reader.append(para);

      groups.forEach((g, si) => {
        if (breaks.has(si)) { para = document.createElement('p'); reader.append(para); }
        else if (si > 0) para.append(' ');
        const sentEl = document.createElement('span');
        sentEl.className = 'sent';
        para.append(sentEl);
        sentences.push({ el: sentEl, text: '' });
        // trim trailing whitespace inside the sentence
        while (g.length && /^\s+$/.test(g[g.length - 1].seg)) g.pop();
        for (const { seg, word } of g) {
          sentences[si].text += seg;
          if (word) {
            const el = document.createElement('span');
            el.className = 'word';
            el.textContent = seg;
            el.dataset.i = String(words.length);
            sentEl.append(el);
            words.push({ el, s: si });
            marks.push(total);
            total += [...seg].length * (CJK.test(seg) ? 2.2 : 1) + 1;
          } else {
            sentEl.append(seg);
            if (SENT_END.test(seg)) total += 8;
            else if (/[:;：；]/.test(seg)) total += 6;
            else if (/[,،、，—–]/.test(seg)) total += 3;
          }
        }
      });
      sentences.forEach((x) => (x.text = x.text.trim()));
      curWord = -1; curSent = -1;
      reader.scrollTop = 0;
    }

    function highlight(i: number) {
      if (i === curWord || !words[i]) return;
      words[curWord]?.el.classList.remove('w-on');
      words[i].el.classList.add('w-on');
      curWord = i;
      const s = words[i].s;
      if (s !== curSent) {
        sentences[curSent]?.el.classList.remove('s-on');
        sentences[s].el.classList.add('s-on');
        curSent = s;
        nowEl.textContent = short(sentences[s].text);
      }
      const el = words[i].el;
      const target = el.getBoundingClientRect().top - reader.getBoundingClientRect().top + reader.scrollTop - reader.clientHeight * 0.4;
      if (Math.abs(reader.scrollTop - target) > 24) reader.scrollTo({ top: Math.max(0, target), behavior: 'smooth' });
    }

    function sync() {
      if (!audio.duration) return;
      const w = Math.min(1, (audio.currentTime + 0.12) / audio.duration) * total;
      let i = 0;
      while (i + 1 < marks.length && marks[i + 1] <= w) i++;
      highlight(i);
      curEl.textContent = fmt(audio.currentTime);
      fill.style.width = `${(audio.currentTime / audio.duration) * 100}%`;
    }

    function loop() {
      sync();
      if (state === 'playing') raf = requestAnimationFrame(loop);
    }

    function clearMarks() {
      words[curWord]?.el.classList.remove('w-on');
      sentences[curSent]?.el.classList.remove('s-on');
      curWord = -1; curSent = -1;
    }

    function loadVoice(next: string) {
      cancelAnimationFrame(raf);
      audio.pause();
      code = next;
      audio.src = `/demo/${code}.mp3`;
      audio.playbackRate = SPEEDS[speedIdx];
      buildReader();
      fill.style.width = '0%';
      curEl.textContent = '0:00';
      durEl.textContent = '0:00';
      nowEl.textContent = ui.press;
      status.textContent = '';
      setState('idle');
    }

    async function start() {
      status.textContent = '';
      if (audio.readyState < 1) { setState('loading'); nowEl.textContent = ui.loading; }
      try {
        await audio.play();
        audio.playbackRate = SPEEDS[speedIdx];
        setState('playing');
        raf = requestAnimationFrame(loop);
      } catch {
        setState('idle');
        nowEl.textContent = ui.press;
        status.textContent = ui.error;
      }
    }

    function timeForWord(i: number) {
      return Math.max(0, (marks[i] / total) * audio.duration - 0.08);
    }

    function seekToWord(i: number) {
      if (audio.duration) {
        audio.currentTime = timeForWord(i);
        sync();
      } else {
        pendingSeek = i;
      }
      if (state !== 'playing') start();
    }

    playBtn.addEventListener('click', () => {
      if (state === 'playing') {
        audio.pause();
        cancelAnimationFrame(raf);
        setState('paused');
      } else {
        start();
      }
    });

    reader.addEventListener('click', (e) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>('.word');
      if (el) seekToWord(Number(el.dataset.i));
    });

    root.querySelectorAll<HTMLButtonElement>('.vd-skip').forEach((b) =>
      b.addEventListener('click', () => {
        if (!audio.duration) return;
        audio.currentTime = Math.max(0, Math.min(audio.duration - 0.05, audio.currentTime + Number(b.dataset.skip)));
        sync();
      })
    );

    speedBtn.addEventListener('click', () => {
      speedIdx = (speedIdx + 1) % SPEEDS.length;
      audio.playbackRate = SPEEDS[speedIdx];
      speedBtn.textContent = `${SPEEDS[speedIdx]}x`;
    });

    // Language picker with type-to-filter
    let active = -1;
    const visible = () => items.filter((li) => !li.hidden);
    function markActive(i: number) {
      const vis = visible();
      vis.forEach((li) => li.classList.remove('active'));
      active = Math.max(0, Math.min(vis.length - 1, i));
      vis[active]?.classList.add('active');
      vis[active]?.scrollIntoView({ block: 'nearest' });
    }
    function openPop() {
      pop.hidden = false;
      langBtn.setAttribute('aria-expanded', 'true');
      search.value = '';
      filter();
      const cur = visible().findIndex((li) => li.dataset.code === code);
      markActive(cur);
      search.focus();
    }
    function closePop(focusBtn = false) {
      pop.hidden = true;
      langBtn.setAttribute('aria-expanded', 'false');
      if (focusBtn) langBtn.focus();
    }
    function filter() {
      const q = search.value.trim().toLowerCase();
      items.forEach((li) => (li.hidden = !!q && !li.dataset.q!.includes(q)));
      noMatch.hidden = visible().length > 0;
      markActive(0);
    }
    function choose(li?: HTMLElement) {
      if (!li) return;
      const next = li.dataset.code!;
      items.forEach((x) => x.setAttribute('aria-selected', x === li ? 'true' : 'false'));
      langCur.textContent = li.querySelector('.n')!.textContent;
      closePop(true);
      if (next !== code) loadVoice(next);
    }
    langBtn.addEventListener('click', () => (pop.hidden ? openPop() : closePop()));
    search.addEventListener('input', filter);
    search.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); markActive(active + 1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); markActive(active - 1); }
      else if (e.key === 'Enter') { e.preventDefault(); choose(visible()[active]); }
      else if (e.key === 'Escape') { e.preventDefault(); closePop(true); }
    });
    items.forEach((li) => {
      li.addEventListener('click', () => choose(li));
      li.addEventListener('mousemove', () => { const i = visible().indexOf(li); if (i !== active) markActive(i); });
    });
    document.addEventListener('pointerdown', (e) => {
      if (!pop.hidden && !(e.target as HTMLElement).closest('.vd-lang')) closePop();
    });

    // Text size (0 = small, 1 = default, 2 = large)
    root.querySelectorAll<HTMLButtonElement>('.vd-size button').forEach((b) =>
      b.addEventListener('click', () => {
        const next = Math.max(0, Math.min(SIZES - 1, Number(reader.dataset.size) + Number(b.dataset.size)));
        reader.dataset.size = String(next);
        const [minus, plus] = root.querySelectorAll<HTMLButtonElement>('.vd-size button');
        minus.disabled = next === 0;
        plus.disabled = next === SIZES - 1;
        if (curWord >= 0) { const w = curWord; curWord = -1; highlight(w); }
      })
    );

    audio.addEventListener('loadedmetadata', () => {
      durEl.textContent = fmt(audio.duration);
      if (pendingSeek !== null) { audio.currentTime = timeForWord(pendingSeek); pendingSeek = null; }
    });
    audio.addEventListener('ended', () => {
      cancelAnimationFrame(raf);
      clearMarks();
      fill.style.width = '100%';
      curEl.textContent = fmt(audio.duration);
      nowEl.textContent = ui.again;
      setState('idle');
      cta.hidden = false;
    });
    audio.addEventListener('error', () => {
      if (!audio.src) return;
      setState('idle');
      status.textContent = ui.error;
    });

    loadVoice(code);
  });
</script>

<style>
  .vd {
    --blue: var(--color-accent);
    --ink: #1c1f24;
    --soft: #8b919a;
    width: 100%;
    max-width: 540px;
    margin: 0 auto;
    text-align: start;
  }
  .vd-win {
    background: #fff;
    border-radius: 18px;
    border: 1px solid rgba(15, 23, 42, 0.08);
    box-shadow: 0 2px 4px rgba(15, 23, 42, 0.04), 0 24px 60px -18px rgba(15, 23, 42, 0.28);
  }

  .vd-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    height: 46px;
    padding: 0 0.6rem 0 0.9rem;
    border-bottom: 1px solid #eef0f3;
    border-radius: 18px 18px 0 0;
    background: #fff;
    position: relative;
    z-index: 5;
  }
  .vd-dots { display: flex; gap: 6px; flex: none; }
  .vd-dots i { width: 10px; height: 10px; border-radius: 50%; background: #e3e6ea; }

  .vd-lang { position: relative; min-width: 0; }
  .vd-lang-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    max-width: 100%;
    height: 28px;
    padding: 0 0.55rem;
    border: 0;
    border-radius: 7px;
    background: transparent;
    font: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ink);
    cursor: pointer;
    transition: background 0.15s;
  }
  .vd-lang-btn:hover, .vd-lang-btn[aria-expanded='true'] { background: #f2f4f7; }
  .vd-lang-btn:focus-visible { outline: 2px solid rgba(37, 99, 235, 0.4); outline-offset: 1px; }
  .vd-lang-btn svg { flex: none; color: var(--soft); }
  .vd-lang-cur { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .vd-pop {
    position: absolute;
    top: calc(100% + 6px);
    left: 50%;
    margin-left: -125px;
    width: 250px;
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 0 0 1px rgba(15, 23, 42, 0.08), 0 18px 40px -12px rgba(15, 23, 42, 0.3);
    padding: 6px;
    z-index: 20;
    animation: vd-fade 0.14s ease-out;
  }
  .vd-pop[hidden] { display: none; }
  .vd-search {
    width: 100%;
    height: 34px;
    padding: 0 0.65rem;
    border: 1px solid #e6e8ec;
    border-radius: 8px;
    font: inherit;
    font-size: 0.85rem;
    color: var(--ink);
    background: #fafbfc;
    outline: none;
  }
  .vd-search:focus { border-color: rgba(37, 99, 235, 0.5); background: #fff; }
  .vd-list {
    list-style: none;
    margin: 6px 0 0;
    padding: 0;
    max-height: 220px;
    overflow-y: auto;
    scrollbar-width: thin;
  }
  .vd-list li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.4rem 0.6rem;
    border-radius: 7px;
    font-size: 0.85rem;
    color: var(--ink);
    cursor: pointer;
  }
  .vd-list li[hidden] { display: none; }
  .vd-list li .n { white-space: nowrap; }
  .vd-list li .e { min-width: 0; font-size: 0.72rem; color: var(--soft); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .vd-list li.active { background: #f2f5fb; }
  .vd-list li[aria-selected='true'] { color: var(--blue); font-weight: 600; }
  .vd-nomatch { margin: 0.5rem 0.6rem; font-size: 0.8rem; color: var(--soft); }
  .vd-nomatch[hidden] { display: none; }

  .vd-size {
    display: inline-flex;
    align-items: center;
    flex: none;
    border-radius: 7px;
    background: #f4f5f7;
    padding: 2px;
  }
  .vd-size button {
    width: 30px;
    height: 24px;
    border: 0;
    border-radius: 5px;
    background: transparent;
    font: inherit;
    font-weight: 700;
    font-size: 0.72rem;
    color: var(--ink);
    cursor: pointer;
    line-height: 1;
  }
  .vd-size button.big { font-size: 0.9rem; }
  .vd-size button span { font-size: 0.7rem; font-weight: 600; margin-inline-start: 1px; }
  .vd-size button:hover:not(:disabled) { background: #fff; box-shadow: 0 1px 2px rgba(15, 23, 42, 0.08); }
  .vd-size button:disabled { color: #c3c7cd; cursor: default; }

  .vd-page { background: #f3f4f6; padding: 1.1rem 1.1rem 0; display: flow-root; border-radius: 0 0 18px 18px; }
  .vd-paper {
    position: relative;
    background: #fff;
    border-radius: 10px;
    box-shadow: 0 0 0 1px rgba(15, 23, 42, 0.04), 0 1px 3px rgba(15, 23, 42, 0.04);
    overflow: hidden;
  }
  .vd-paper::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 3.5rem;
    background: linear-gradient(rgba(255, 255, 255, 0), #fff 75%);
    pointer-events: none;
  }
  .vd-reader {
    height: 15.5rem;
    padding: 1.5rem 1.75rem 3.25rem;
    font-family: Charter, 'Iowan Old Style', Georgia, 'Times New Roman', serif;
    font-size: 1rem;
    line-height: 1.75;
